# Connexió a PostgreSQL via variables independents (Model recomanat):
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=password
DB_NAME=trainee
DB_SSLMODE=disable

# O alternativament mitjançant connection string unificada:
# DB_URL=postgres://user:password@localhost:5432/trainee?sslmode=disable

JWT_SECRET=canvia_aquest_secret_en_produccio
PORT=8080
ENV=development

# Frontend URL (used in emails and CORS)
FRONTEND_URL=https://trainee.entrenadortrail.es
ALLOWED_ORIGINS=http://localhost:5173

# Cloudflare R2 Configuration (leave empty to fall back to local storage)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
